# --- Persistence -----------------------------------------------------------
# Zero-setup default (local file). For PostgreSQL use e.g.:
#   DATABASE_URL=postgresql+asyncpg://radar:radar@localhost:5432/signal_radar
DATABASE_URL=sqlite+aiosqlite:///./signal_radar.db

# --- Web -------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000
# In production add your Vercel domain(s), comma-separated, e.g.
#   CORS_ORIGINS=https://signdex-radar.vercel.app
# Optional regex for Vercel preview URLs (leave empty unless you need previews):
#   CORS_ORIGIN_REGEX=https://signdex-radar-.*\.vercel\.app
CORS_ORIGIN_REGEX=

# --- AchroCall (achrocall.com) ---------------------------------------------
# Leave ACHROCALL_WEBHOOK_URL empty to run in SANDBOX mode: dispatches are
# validated and recorded locally but nothing is sent to achrocall.com.
# Set it to the ingestion webhook URL issued by AchroCall to go live.
ACHROCALL_WEBHOOK_URL=
ACHROCALL_API_KEY=
ACHROCALL_TIMEOUT_SECONDS=10
# If set, POST /api/achrocall/callback requires this value in the X-Achrocall-Secret header.
ACHROCALL_CALLBACK_SECRET=

# Assumption used for the "Estimated Automated Pipeline ARR" metric
# (annual AchroCall revenue per business location, USD). Placeholder - set to real pricing.
ACHROCALL_ARR_PER_LOCATION=9600

# Sandbox only: simulate AchroCall finishing the call a few seconds after dispatch.
SANDBOX_AUTO_COMPLETE=true

# --- Demo data -------------------------------------------------------------
SEED_COUNT=12
# Rebuild simulated demo data on startup when the newest signal is older than this.
RESEED_IF_STALE_HOURS=6

# --- Vapi.ai (optional, reported by /api/vapi/trigger-call) -----------------
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
