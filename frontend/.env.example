# Base URL of the deployed FastAPI backend (https, no trailing slash).
# REQUIRED on Vercel: set it under Project Settings -> Environment Variables, then redeploy
# (NEXT_PUBLIC_* values are inlined at build time).
# Optional locally: when the page is served from localhost it falls back to http://localhost:8000.
# NEXT_PUBLIC_API_URL=https://your-backend.example.com
